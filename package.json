{
  "name": "discord-ai-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "commands:deploy": "tsx src/scripts/deployCommands.ts",
    "dump:context": "tsx src/scripts/dumpContext.ts"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
