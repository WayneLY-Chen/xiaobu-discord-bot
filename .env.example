# 複製成 .env 後填入實際值。
# .env 已被 .gitignore 排除，絕對不要把它 commit 進版本控制。

# =============================================================================
# Discord（必填）
# =============================================================================
# Discord Developer Portal -> 你的 App -> Bot -> Reset Token
DISCORD_TOKEN=

# Discord Developer Portal -> 你的 App -> General Information -> Application ID
DISCORD_CLIENT_ID=

# 開發用：填入測試伺服器 ID，slash command 會立即生效。
# 正式部署請留空，指令會註冊為全域指令（Discord 端最多需要 1 小時生效）。
DEV_GUILD_ID=

# 啟動時自動註冊 slash command。設為 false 就改用 npm run commands:deploy 手動註冊。
DEPLOY_COMMANDS_ON_START=true

# =============================================================================
# AI Provider（下面兩把 Key 至少要填一把）
# =============================================================================
# 兩把都填的話，Gemini 是主力，Gemini 掛掉時自動換 Groq 接手。
# 只填一把也能跑，只是額度用完就沒有備援了。

# https://aistudio.google.com/apikey 取得，免費層不需要信用卡。
GEMINI_API_KEY=

# https://console.groq.com/keys 取得。
# 免費層每個模型 30 RPM / 1,000 RPD / 200K TPD（2026-09 查證）。
# Groq 的 Services Agreement 明文允許把服務提供給你的 End User，
# 所以拿來做公開邀請的 Bot 沒有條款問題。
GROQ_API_KEY=

# 預設模型。可用值見 src/config/constants.ts 的 MODEL_CATALOG。
# 注意：這個模型所屬的 provider 一定要有填 Key，否則啟動時會直接報錯。
# flash-lite 的免費額度比 flash 寬鬆，當聊天 Bot 預設最省。
DEFAULT_MODEL=gemini-3.1-flash-lite

# 主力 provider 失敗（額度用完、逾時、認證錯誤）時，自動改用其他免費 provider。
# 內容被安全機制擋下時不會換手 —— 那不是服務故障。
AI_FALLBACK_ENABLED=true

# 硬性要求：預設 false，程式不會自動使用任何付費 API。
# 目前接的 Gemini 與 Groq 都是免費層，這個開關是留給未來的保險。
ALLOW_PAID_PROVIDERS=false

# 單次 AI 請求逾時（毫秒）
AI_TIMEOUT_MS=25000

# 單次回覆的最大輸出 token
AI_MAX_OUTPUT_TOKENS=2048

# =============================================================================
# 工具（搜尋、天氣、計算機、時間、記憶）
# =============================================================================
# 天氣用 Open-Meteo，免費且不需要 API Key，這裡沒有東西要填。
# 計算機、時間、記憶都在本機處理，也不需要外部服務。

# Tavily 搜尋。選填，https://tavily.com 申請，不需要綁信用卡。
# 免費層每月 1,000 次、每月 1 號重置。
# 沒填的話會改用 Gemini 的 Google 搜尋 grounding（每天 500 次），
# 兩個都沒有的話搜尋工具就不會提供給模型，聊天本身不受影響。
TAVILY_API_KEY=

# 單一工具呼叫的逾時（毫秒）。比 AI_TIMEOUT_MS 短，卡住的工具不該拖垮整輪對話。
TOOL_TIMEOUT_MS=15000

# =============================================================================
# 對話上下文
# =============================================================================
# 每次送進模型的歷史訊息則數（含 Bot 的回覆）
CONTEXT_MESSAGE_LIMIT=20

# 單則使用者訊息超過這個長度就截斷
MAX_INPUT_LENGTH=4000

# =============================================================================
# Rate Limit（防止單一使用者或伺服器吃光免費額度）
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_USER=5
RATE_LIMIT_GUILD=20
RATE_LIMIT_GLOBAL=60

# =============================================================================
# 基礎設施
# =============================================================================
# 本機開發用相對路徑；Docker 由 docker-compose.yml 覆寫成 /app/data/bot.db
DATABASE_PATH=./data/bot.db

# 健康檢查端點只綁 127.0.0.1，不對外開放
HEALTH_PORT=3000

# Docker 專用：容器要以哪個 uid/gid 執行。
# 必須是主機上擁有 ./data 目錄的使用者，否則 SQLite 會因權限不足而
# 出現 "unable to open database file"。
# 在主機執行 `id -u` 和 `id -g` 取得數字後填入。
# 只用本機開發（npm run dev）的話可以忽略這兩項。
APP_UID=1000
APP_GID=1000

# debug | info | warn | error
LOG_LEVEL=info

NODE_ENV=production
TZ=Asia/Taipei
